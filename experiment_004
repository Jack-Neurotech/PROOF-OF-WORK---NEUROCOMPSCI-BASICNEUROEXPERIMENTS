"""Experiment 004: competing synapses targeting one postsynaptic neuron."""

from pathlib import Path

import matplotlib.pyplot as plt
import numpy as np

from Stdp_models import STDPParameters, weight_change


def update_weight(
    weight: float,
    delta_t_ms: float,
    parameters: STDPParameters,
    weight_min: float,
    weight_max: float,
) -> tuple[float, float]:
    """Apply one STDP update and enforce synaptic bounds."""

    delta_w = weight_change(delta_t_ms, parameters)

    new_weight = float(
        np.clip(
            weight + delta_w,
            weight_min,
            weight_max,
        )
    )

    actual_change = new_weight - weight

    return new_weight, actual_change


def main() -> None:
    parameters = STDPParameters()

    initial_weight_a = 0.5
    initial_weight_b = 0.5

    weight_min = 0.0
    weight_max = 1.0

    pairings = 100

    # Synapse A consistently experiences causal timing.
    delta_t_a = 10.0

    # Synapse B consistently experiences anti-causal timing.
    delta_t_b = -10.0

    weights_a = np.empty(pairings + 1)
    weights_b = np.empty(pairings + 1)

    changes_a = np.empty(pairings)
    changes_b = np.empty(pairings)

    weights_a[0] = initial_weight_a
    weights_b[0] = initial_weight_b

    for pairing in range(pairings):
        weights_a[pairing + 1], changes_a[pairing] = update_weight(
            weights_a[pairing],
            delta_t_a,
            parameters,
            weight_min,
            weight_max,
        )

        weights_b[pairing + 1], changes_b[pairing] = update_weight(
            weights_b[pairing],
            delta_t_b,
            parameters,
            weight_min,
            weight_max,
        )

    data_dir = Path("results/data")
    figure_dir = Path("results/figures")

    data_dir.mkdir(parents=True, exist_ok=True)
    figure_dir.mkdir(parents=True, exist_ok=True)

    pairing_numbers = np.arange(pairings + 1)

    data = np.column_stack(
        (
            pairing_numbers,
            weights_a,
            weights_b,
        )
    )

    np.savetxt(
        data_dir / "experiment_004_competing_synapses.csv",
        data,
        delimiter=",",
        header="pairing,synapse_a_weight,synapse_b_weight",
        comments="",
        fmt=["%d", "%.9f", "%.9f"],
    )

    # Plot both competing synapses.
    figure, axis = plt.subplots(figsize=(10, 5))

    axis.plot(
        pairing_numbers,
        weights_a,
        linewidth=2,
        label="Synapse A: causal (+10 ms)",
    )

    axis.plot(
        pairing_numbers,
        weights_b,
        linewidth=2,
        label="Synapse B: anti-causal (-10 ms)",
    )

    axis.axhline(
        0.5,
        linewidth=1,
        label="Initial weight",
    )

    axis.set_xlabel("Pairing number")
    axis.set_ylabel("Synaptic weight")
    axis.set_title("Experiment 004 — Competing Synapses")
    axis.set_ylim(-0.05, 1.05)
    axis.grid(True, alpha=0.25)
    axis.legend()

    figure.tight_layout()

    figure.savefig(
        figure_dir / "experiment_004_competing_synapses.png",
        dpi=300,
    )

    plt.close(figure)

    # Plot the difference between the synapses.
    weight_difference = weights_a - weights_b

    figure, axis = plt.subplots(figsize=(10, 5))

    axis.plot(
        pairing_numbers,
        weight_difference,
        linewidth=2,
    )

    axis.axhline(0.0, linewidth=1)

    axis.set_xlabel("Pairing number")
    axis.set_ylabel("Weight difference (A − B)")
    axis.set_title("Experiment 004 — Synaptic Competition")
    axis.grid(True, alpha=0.25)

    figure.tight_layout()

    figure.savefig(
        figure_dir / "experiment_004_weight_difference.png",
        dpi=300,
    )

    plt.close(figure)

    print("STDP EXPERIMENT 004")
    print("=" * 60)
    print(f"Initial Synapse A weight: {initial_weight_a:.3f}")
    print(f"Initial Synapse B weight: {initial_weight_b:.3f}")
    print(f"Pairings:                 {pairings}")
    print()

    print("RESULTS")
    print("-" * 60)

    print("Synapse A — causal timing")
    print(f"  Δt:           {delta_t_a:+.1f} ms")
    print(f"  Final weight: {weights_a[-1]:.6f}")
    print(f"  Net change:   {weights_a[-1] - weights_a[0]:+.6f}")
    print()

    print("Synapse B — anti-causal timing")
    print(f"  Δt:           {delta_t_b:+.1f} ms")
    print(f"  Final weight: {weights_b[-1]:.6f}")
    print(f"  Net change:   {weights_b[-1] - weights_b[0]:+.6f}")
    print()

    print("COMPETITION")
    print("-" * 60)
    print(f"Final A − B difference: {weight_difference[-1]:+.6f}")

    if weights_a[-1] > weights_b[-1]:
        print("Causal synapse dominates: PASS")
    else:
        print("Causal synapse dominates: FAIL")
        raise SystemExit(1)

    if (
        np.all(weights_a >= weight_min)
        and np.all(weights_a <= weight_max)
        and np.all(weights_b >= weight_min)
        and np.all(weights_b <= weight_max)
    ):
        print("Weight bounds: PASS")
    else:
        print("Weight bounds: FAIL")
        raise SystemExit(1)

    print()
    print(
        "DATA:",
        data_dir / "experiment_004_competing_synapses.csv",
    )
    print(
        "FIGURE:",
        figure_dir / "experiment_004_competing_synapses.png",
    )
    print(
        "DIFFERENCE:",
        figure_dir / "experiment_004_weight_difference.png",
    )


if __name__ == "__main__":
    main()