"""Experiment 002: repeated spike pairing with bounded synaptic weights."""

from pathlib import Path

import matplotlib.pyplot as plt
import numpy as np

from Stdp_models import STDPParameters, weight_change


def run_condition(
    delta_t_ms: float,
    initial_weight: float,
    pairings: int,
    parameters: STDPParameters,
    weight_min: float,
    weight_max: float,
) -> tuple[np.ndarray, np.ndarray]:
    """Simulate repeated STDP pairings with bounded synaptic weight."""

    if not weight_min <= initial_weight <= weight_max:
        raise ValueError("Initial weight must be within the weight bounds.")

    weights = np.empty(pairings + 1)
    changes = np.empty(pairings)

    weights[0] = initial_weight

    for pairing in range(pairings):
        delta_w = weight_change(delta_t_ms, parameters)

        proposed_weight = weights[pairing] + delta_w
        new_weight = np.clip(
            proposed_weight,
            weight_min,
            weight_max,
        )

        changes[pairing] = new_weight - weights[pairing]
        weights[pairing + 1] = new_weight

    return weights, changes


def main() -> None:
    parameters = STDPParameters()

    initial_weight = 0.5
    weight_min = 0.0
    weight_max = 1.0
    pairings = 100

    conditions = {
        "causal_10ms": 10.0,
        "anti_causal_10ms": -10.0,
        "simultaneous": 0.0,
    }

    data_dir = Path("results/data")
    figure_dir = Path("results/figures")

    data_dir.mkdir(parents=True, exist_ok=True)
    figure_dir.mkdir(parents=True, exist_ok=True)

    results = {}

    for name, delta_t_ms in conditions.items():
        weights, changes = run_condition(
            delta_t_ms=delta_t_ms,
            initial_weight=initial_weight,
            pairings=pairings,
            parameters=parameters,
            weight_min=weight_min,
            weight_max=weight_max,
        )

        results[name] = (delta_t_ms, weights, changes)

    rows = []

    for name, (delta_t_ms, weights, changes) in results.items():
        for pairing in range(pairings + 1):
            delta_w = 0.0 if pairing == 0 else changes[pairing - 1]

            rows.append(
                (
                    name,
                    pairing,
                    delta_t_ms,
                    delta_w,
                    weights[pairing],
                )
            )

    output = np.array(
        rows,
        dtype=[
            ("condition", "U32"),
            ("pairing", "i4"),
            ("delta_t_ms", "f8"),
            ("delta_w", "f8"),
            ("weight", "f8"),
        ],
    )

    np.savetxt(
        data_dir / "experiment_002_weight_learning.csv",
        output,
        delimiter=",",
        header="condition,pairing,delta_t_ms,delta_w,weight",
        comments="",
        fmt=["%s", "%d", "%.6f", "%.9f", "%.9f"],
    )

    figure, axis = plt.subplots(figsize=(9, 5))

    for name, (delta_t_ms, weights, _) in results.items():
        axis.plot(
            np.arange(pairings + 1),
            weights,
            linewidth=2,
            label=f"{name} (Δt={delta_t_ms:g} ms)",
        )

    axis.axhline(
        initial_weight,
        linewidth=1,
        label="Initial weight",
    )

    axis.axhline(weight_min, linewidth=1)
    axis.axhline(weight_max, linewidth=1)

    axis.set_xlabel("Pairing number")
    axis.set_ylabel("Synaptic weight w")
    axis.set_title("Repeated Spike Pairing and Bounded Synaptic Weight")
    axis.set_ylim(-0.05, 1.05)
    axis.legend()
    axis.grid(True, alpha=0.25)

    figure.tight_layout()

    figure.savefig(
        figure_dir / "experiment_002_weight_learning.png",
        dpi=300,
    )

    plt.close(figure)

    print("STDP EXPERIMENT 002")
    print("=" * 60)
    print(f"Initial weight: {initial_weight:.3f}")
    print(f"Weight bounds:  {weight_min:.1f} to {weight_max:.1f}")
    print(f"Pairings:       {pairings}")
    print()

    for name, (delta_t_ms, weights, changes) in results.items():
        print(name)
        print(f"  Δt:             {delta_t_ms:+.1f} ms")
        print(f"  First Δw:       {changes[0]:+.6f}")
        print(f"  Final weight:   {weights[-1]:.6f}")
        print(f"  Minimum weight: {weights.min():.6f}")
        print(f"  Maximum weight: {weights.max():.6f}")
        print()

    print("BOUND CHECK")
    print("-" * 60)

    all_weights = np.concatenate(
        [weights for _, weights, _ in results.values()]
    )

    if np.all(all_weights >= weight_min) and np.all(
        all_weights <= weight_max
    ):
        print("All weights within bounds: PASS")
    else:
        print("All weights within bounds: FAIL")
        raise SystemExit(1)

    print()
    print("DATA:", data_dir / "experiment_002_weight_learning.csv")
    print("FIGURE:", figure_dir / "experiment_002_weight_learning.png")


if __name__ == "__main__":
    main()