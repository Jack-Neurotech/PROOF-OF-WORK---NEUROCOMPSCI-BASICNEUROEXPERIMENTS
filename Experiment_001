"""Experiment 001: measure the STDP timing-dependent learning window."""

from pathlib import Path

import matplotlib.pyplot as plt
import numpy as np

from Stdp_models import STDPParameters, weight_change


def main() -> None:
    parameters = STDPParameters()

    delta_t_ms = np.arange(-50.0, 51.0, 1.0)

    delta_w = np.array(
        [
            weight_change(dt, parameters)
            for dt in delta_t_ms
        ]
    )

    data_dir = Path("results/data")
    figure_dir = Path("results/figures")

    data_dir.mkdir(parents=True, exist_ok=True)
    figure_dir.mkdir(parents=True, exist_ok=True)

    data = np.column_stack((delta_t_ms, delta_w))

    np.savetxt(
        data_dir / "stdp_timing_curve.csv",
        data,
        delimiter=",",
        header="delta_t_ms,delta_w",
        comments="",
    )

    figure, axis = plt.subplots(figsize=(8, 5))

    axis.plot(delta_t_ms, delta_w, linewidth=2)
    axis.axhline(0.0, linewidth=1)
    axis.axvline(0.0, linewidth=1)

    axis.set_xlabel("Spike timing difference Δt (ms)")
    axis.set_ylabel("Synaptic weight change Δw")
    axis.set_title("STDP Timing-Dependent Plasticity")

    axis.grid(True, alpha=0.25)
    figure.tight_layout()

    figure.savefig(
        figure_dir / "stdp_timing_curve.png",
        dpi=300,
    )

    plt.close(figure)

    print("STDP EXPERIMENT 001")
    print("=" * 50)
    print(f"Timing range: {delta_t_ms.min():.0f} to {delta_t_ms.max():.0f} ms")
    print(f"Measurements: {len(delta_t_ms)}")
    print(f"Maximum potentiation: {delta_w.max():.6f}")
    print(f"Maximum depression: {delta_w.min():.6f}")
    print()
    print("DATA:", data_dir / "stdp_timing_curve.csv")
    print("FIGURE:", figure_dir / "stdp_timing_curve.png")


if __name__ == "__main__":
    main()
