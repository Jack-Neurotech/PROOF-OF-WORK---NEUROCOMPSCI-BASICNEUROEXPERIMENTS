"""Experiment 005: a small neural network with STDP."""

from pathlib import Path
import sys

import matplotlib.pyplot as plt
import numpy as np

# Make the sibling ``models`` package resolvable when this script is run
# directly from any working directory.
sys.path.insert(0, str(Path(__file__).resolve().parent))

from Stdp_models import STDPParameters, weight_change


def main() -> None:
    parameters = STDPParameters()

    n_inputs = 4
    n_trials = 100

    initial_weight = 0.5
    weight_min = 0.0
    weight_max = 1.0

    # Each row is one trial.
    # Columns are the four input neurons.
    #
    # The first two inputs fire before the output.
    # The last two fire after the output.
    input_times_ms = np.array(
        [
            [40.0, 45.0, 55.0, 60.0],
            [40.0, 45.0, 55.0, 60.0],
            [40.0, 45.0, 55.0, 60.0],
            [40.0, 45.0, 55.0, 60.0],
        ]
    )

    output_time_ms = 50.0

    weights = np.full(n_inputs, initial_weight)
    history = np.empty((n_trials + 1, n_inputs))
    history[0] = weights

    delta_history = np.empty((n_trials, n_inputs))

    for trial in range(n_trials):
        trial_changes = np.zeros(n_inputs)

        for neuron in range(n_inputs):
            delta_t = output_time_ms - input_times_ms[trial % len(input_times_ms), neuron]

            delta_w = weight_change(delta_t, parameters)

            new_weight = np.clip(
                weights[neuron] + delta_w,
                weight_min,
                weight_max,
            )

            trial_changes[neuron] = new_weight - weights[neuron]
            weights[neuron] = new_weight

        delta_history[trial] = trial_changes
        history[trial + 1] = weights

    data_dir = Path("results/data")
    figure_dir = Path("results/figures")

    data_dir.mkdir(parents=True, exist_ok=True)
    figure_dir.mkdir(parents=True, exist_ok=True)

    # Save weight history.
    rows = []

    for trial in range(n_trials + 1):
        rows.append(
            (
                trial,
                *history[trial],
            )
        )

    np.savetxt(
        data_dir / "experiment_005_network_weights.csv",
        np.array(rows),
        delimiter=",",
        header="trial,weight_1,weight_2,weight_3,weight_4",
        comments="",
        fmt=["%d", "%.9f", "%.9f", "%.9f", "%.9f"],
    )

    # Save per-trial plasticity changes.
    change_rows = []

    for trial in range(n_trials):
        change_rows.append(
            (
                trial + 1,
                *delta_history[trial],
            )
        )

    np.savetxt(
        data_dir / "experiment_005_weight_changes.csv",
        np.array(change_rows),
        delimiter=",",
        header="trial,delta_w_1,delta_w_2,delta_w_3,delta_w_4",
        comments="",
        fmt=["%d", "%.9f", "%.9f", "%.9f", "%.9f"],
    )

    # Plot synaptic weight evolution.
    figure, axis = plt.subplots(figsize=(10, 5))

    for neuron in range(n_inputs):
        axis.plot(
            np.arange(n_trials + 1),
            history[:, neuron],
            linewidth=2,
            label=f"Synapse {neuron + 1}",
        )

    axis.axhline(
        initial_weight,
        linewidth=1,
        label="Initial weight",
    )

    axis.set_xlabel("Trial")
    axis.set_ylabel("Synaptic weight")
    axis.set_title("Experiment 005 — Plastic Neural Network")
    axis.set_ylim(-0.05, 1.05)
    axis.grid(True, alpha=0.25)
    axis.legend()

    figure.tight_layout()

    figure.savefig(
        figure_dir / "experiment_005_network_weights.png",
        dpi=300,
    )

    plt.close(figure)

    # Plot final network weights.
    figure, axis = plt.subplots(figsize=(7, 5))

    axis.bar(
        np.arange(1, n_inputs + 1),
        weights,
    )

    axis.set_xlabel("Input neuron")
    axis.set_ylabel("Final synaptic weight")
    axis.set_title("Experiment 005 — Final Network Weights")
    axis.set_ylim(0.0, 1.05)
    axis.grid(True, axis="y", alpha=0.25)

    figure.tight_layout()

    figure.savefig(
        figure_dir / "experiment_005_final_weights.png",
        dpi=300,
    )

    plt.close(figure)

    print("STDP EXPERIMENT 005")
    print("=" * 60)
    print("Network: 4 input neurons -> 1 output neuron")
    print(f"Trials: {n_trials}")
    print(f"Initial weight: {initial_weight:.3f}")
    print(f"Weight bounds: {weight_min:.1f} to {weight_max:.1f}")
    print()

    print("SPIKE TIMING")
    print("-" * 60)

    for neuron in range(n_inputs):
        input_time = input_times_ms[0, neuron]
        delta_t = output_time_ms - input_time

        print(
            f"Input {neuron + 1}: "
            f"t_pre={input_time:.1f} ms, "
            f"t_post={output_time_ms:.1f} ms, "
            f"Δt={delta_t:+.1f} ms"
        )

    print()
    print("FINAL SYNAPTIC WEIGHTS")
    print("-" * 60)

    for neuron in range(n_inputs):
        print(
            f"Synapse {neuron + 1}: "
            f"{history[0, neuron]:.6f} -> "
            f"{history[-1, neuron]:.6f} "
            f"({history[-1, neuron] - history[0, neuron]:+.6f})"
        )

    print()
    print("NETWORK RESULT")
    print("-" * 60)

    if np.all(history >= weight_min) and np.all(history <= weight_max):
        print("Weight bounds: PASS")
    else:
        print("Weight bounds: FAIL")
        raise SystemExit(1)

    if weights[0] > initial_weight and weights[1] > initial_weight:
        print("Causal inputs strengthened: PASS")
    else:
        print("Causal inputs strengthened: FAIL")
        raise SystemExit(1)

    if weights[2] < initial_weight and weights[3] < initial_weight:
        print("Anti-causal inputs weakened: PASS")
    else:
        print("Anti-causal inputs weakened: FAIL")
        raise SystemExit(1)

    print()
    print("DATA:", data_dir / "experiment_005_network_weights.csv")
    print("CHANGES:", data_dir / "experiment_005_weight_changes.csv")
    print("FIGURE:", figure_dir / "experiment_005_network_weights.png")
    print("FINAL:", figure_dir / "experiment_005_final_weights.png")


if __name__ == "__main__":
    main()